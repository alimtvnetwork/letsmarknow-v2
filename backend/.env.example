PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Engine: "sqlite" (default) or "postgres"
DB_DRIVER=sqlite
# SQLite URL (default: local file database in data/letsmarknow.db)
DATABASE_URL=file:./data/letsmarknow.db

# To switch to PostgreSQL anytime, just set:
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/letsmarknow

JWT_SECRET=dev_jwt_access_secret_32_chars_long_minimum
COOKIE_SECRET=dev_cookie_signing_secret_32_chars_long
