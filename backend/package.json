{
  "name": "letsmarknow-backend",
  "version": "0.2.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "bundle": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.2",
    "@libsql/client": "^0.18.0",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.1",
    "jose": "^6.2.12",
    "pino": "^9.6.0",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1",
    "vite_react_shadcn_ts": "file:..",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
