{
  "manifest_version": 3,
  "name": "LetsMarkNow",
  "version": "0.1.0",
  "description": "Save, organize, and reopen browser tabs.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "LetsMarkNow"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "sidePanel",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://letsmarknow.com/*",
      "https://*.letsmarknow.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://letsmarknow.com/*",
        "https://*.letsmarknow.com/*"
      ],
      "js": ["contentScript.js"],
      "run_at": "document_start"
    }
  ]
}
