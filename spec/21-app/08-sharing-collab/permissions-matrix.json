{
  "$schema": "https://letsmarknow.com/schemas/permissions-matrix.v1.json",
  "version": "1.0.0",
  "spec_version": "21-app/v1",
  "generated_from": "spec/21-app/08-sharing-collab/05-permissions-matrix.md",
  "description": "Machine-readable permissions matrix. Single source of truth for RLS policy codegen, server middleware checks, and client UX guards. Server enforces; client mirrors. Drift = bug.",
  "notes": [
    "Roles are exhaustive and locked (see 00-overview/02-glossary.md).",
    "ROLE-SCOPE DISTINCTION (SI-011 closure, 2026-04-20): The canonical `org_role` SQL enum in `17-admin-org/03-roles.md §2` has exactly 7 values: owner, admin, editor, viewer, billing, guest, system. `share_viewer` is NOT a member of `org_role` and MUST NOT be added to the enum. It is a runtime-only pseudo-role attached to a share-link session (no row in `member_roles`). Filter by `scope`: `org` roles persist in `member_roles`; `share` roles (share_viewer, guest-via-share) live only in the share-cookie JWT; `internal` (system) is server-issued.",
    "An action MUST pass: (1) JWT claim role check, (2) server middleware, (3) database RLS. Client guard alone is never sufficient.",
    "'own' qualifier means the actor created the entity; checked via created_by = auth.uid().",
    "'pro_plus' qualifier means action requires Pro / Team / Lifetime entitlement.",
    "'team_only' qualifier means action requires Team entitlement.",
    "'enabled' on share-viewer means the Share's per-feature flag is on.",
    "Boolean false = always denied for that role. Conditions narrow an otherwise-true grant."
  ],

  "roles": {
    "owner":        { "scope": "org",   "billable": true,  "description": "Created the Org. Exactly one per Org. Full control including delete + ownership transfer." },
    "admin":        { "scope": "org",   "billable": true,  "description": "Full control except delete-org and transfer-ownership and billing." },
    "editor":       { "scope": "org",   "billable": true,  "description": "Read/write content. Cannot manage members or billing." },
    "viewer":       { "scope": "org",   "billable": true,  "description": "Read-only across the Org or a specific Space they were invited to." },
    "billing":      { "scope": "org",   "billable": false, "description": "Billing + invoices only. No content access. Does not consume a content seat." },
    "share_viewer": { "scope": "share", "billable": false, "description": "Per-share guest. Read-only by default; comment/react if Share opts in." },
    "guest":        { "scope": "share", "billable": false, "description": "Anonymous public-link viewer. Same caps as share_viewer minus comments unless explicitly enabled." },
    "system":       { "scope": "internal", "billable": false, "description": "Synthetic actor for cron, webhooks, API tokens. Not a Member." }
  },

  "qualifiers": {
    "own":      "created_by = auth.uid()",
    "pro_plus": "org.entitlement IN ('pro','team','lifetime')",
    "team_only":"org.entitlement = 'team'",
    "enabled":  "share.feature_flag = true"
  },

