  "edge_cases": [
    { "case": "last_owner_leave",         "behavior": "Block; require ownership transfer first" },
    { "case": "demoted_mid_edit",         "behavior": "Save returns 403; UI banner explains; draft preserved locally" },
    { "case": "demoted_after_share_create","behavior": "Share remains active; only owner/admin can revoke" },
    { "case": "plan_downgrade_loses_billing_role", "behavior": "Billing-role users converted to viewer; emailed" },
    { "case": "member_removed_mid_session","behavior": "All requests 401; client signs out gracefully" }
  ],

  "enforcement_layers": [
    { "layer": 1, "name": "jwt_claims",     "description": "Role per Org embedded; refreshed on change" },
    { "layer": 2, "name": "server_middleware", "description": "Per-route role + ownership check before handler" },
    { "layer": 3, "name": "database_rls",   "description": "auth.uid() + has_role() security-definer function" },
    { "layer": 4, "name": "client_guards",  "description": "Disabled buttons + tooltips; UX hint only" }
  ],

  "telemetry_events": [
    { "name": "permission.denied_client", "props": ["action", "role"] },
    { "name": "permission.denied_server", "props": ["action", "role"] },
    { "name": "permission.role_changed",  "props": ["from", "to", "actor_id", "target_id"] }
